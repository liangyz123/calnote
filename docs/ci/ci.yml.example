name: 体检（语法 + 接口冒烟）

on:
  push:
  pull_request:

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: 装依赖
        run: pip install -r requirements.txt
      - name: 跑自检（tools/check.py）
        run: python3 tools/check.py
